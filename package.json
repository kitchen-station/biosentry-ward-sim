{
  "name": "biosentry-ward-sim",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "fit": "node scripts/fit-generator.mjs",
    "fit:calibration": "node scripts/fit-eicu.mjs",
    "preview": "vite preview",
    "ward": "vite build --ssr src/headless.ts --outDir dist/ward --logLevel warn && node dist/ward/headless.js",
    "hospital-trial": "vite build --ssr src/hospital-trial.ts --outDir dist/hospital-trial --logLevel warn && node dist/hospital-trial/hospital-trial.js"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
